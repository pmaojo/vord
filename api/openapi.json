{
  "openapi": "3.1.0",
  "info": {
    "title": "yunq API",
    "description": "Static analysis platform: enqueue scans, read issues.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/issues": {
      "get": {
        "summary": "List the most recently detected issues.",
        "operationId": "list_issues",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of issues to return (default 50, capped at 500).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent issues",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IssueDto"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Storage backend unavailable"
          }
        }
      }
    },
    "/scans": {
      "post": {
        "summary": "Enqueue a scan job for asynchronous analysis.",
        "operationId": "enqueue_scan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Scan job queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanQueuedDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid scan request"
          },
          "502": {
            "description": "Queue backend unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IssueDto": {
        "type": "object",
        "required": [
          "rule",
          "severity",
          "file",
          "line",
          "column",
          "message"
        ],
        "properties": {
          "column": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "message": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        }
      },
      "ScanQueuedDto": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "ScanRequestDto": {
        "type": "object",
        "required": [
          "project",
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Path to the checked-out sources, reachable by a worker."
          },
          "project": {
            "type": "string",
            "description": "Project key the scan belongs to."
          }
        }
      }
    }
  }
}
