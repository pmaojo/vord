{
  "openapi": "3.1.0",
  "info": {
    "title": "yunq API",
    "description": "Static analysis platform: REST API, OAuth, signed webhooks and operational metrics.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/me": {
      "get": {
        "summary": "Return the user attached to the current yunq bearer session.",
        "operationId": "current_user",
        "responses": {
          "200": {
            "description": "Current authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/api/auth/oauth/{provider}/callback": {
      "get": {
        "summary": "Finish OAuth login and exchange the provider code for a yunq bearer session.",
        "operationId": "oauth_callback",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "description": "github or gitlab",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OAuth login completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthLoginDto"
                }
              }
            }
          },
          "400": {
            "description": "Provider denied the request or parameters are missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid OAuth state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "502": {
            "description": "Provider exchange failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/oauth/{provider}/login": {
      "get": {
        "summary": "Start an OAuth 2.0 authorization-code flow with GitHub or GitLab.",
        "operationId": "oauth_login",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "description": "github or gitlab",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "307": {
            "description": "Redirect to the provider authorization page"
          },
          "404": {
            "description": "Unknown provider",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "Provider is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthErrorDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/issues/{id}/assign-to-agent": {
      "post": {
        "summary": "Assign an issue to the AI Remediation Agent to automatically generate a verified fix.",
        "operationId": "assign_to_agent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Issue id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "AI Remediation Agent proposal generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentFixProposalDto"
                }
              }
            }
          },
          "404": {
            "description": "Issue not found"
          }
        }
      }
    },
    "/api/projects/{key}/badge.svg": {
      "get": {
        "summary": "Generate SVG status badge for a project.",
        "operationId": "badge_svg",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "description": "Project key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SVG badge",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/metrics": {
      "get": {
        "summary": "Export process, HTTP, OAuth and webhook metrics in Prometheus text format.",
        "operationId": "prometheus_metrics",
        "responses": {
          "200": {
            "description": "Prometheus text exposition",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks": {
      "get": {
        "summary": "List webhook subscriptions without exposing their signing secrets.",
        "operationId": "list_webhooks",
        "responses": {
          "200": {
            "description": "Webhook registrations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WebhookDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired bearer token"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      },
      "post": {
        "summary": "Register a signed webhook subscription.",
        "operationId": "create_webhook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWebhookDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Webhook registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid URL, secret or event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired bearer token"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/api/webhooks/deliveries": {
      "get": {
        "summary": "Read the bounded delivery-attempt log, including retry and terminal outcomes.",
        "operationId": "webhook_delivery_log",
        "parameters": [
          {
            "name": "delivery_id",
            "in": "query",
            "description": "Filter all attempts for one delivery id.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum records to return (default 100, capped at 1000).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Newest delivery attempts first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WebhookAttemptDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired bearer token"
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/api/webhooks/dispatch": {
      "post": {
        "summary": "Queue an event for all subscribed webhooks or one selected registration.",
        "operationId": "dispatch_webhook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DispatchWebhookDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Deliveries queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/QueuedDeliveryDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid event or subscription",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired bearer token"
          },
          "404": {
            "description": "Selected registration was not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorDto"
                }
              }
            }
          },
          "503": {
            "description": "Dispatcher queue unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookErrorDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/hotspots": {
      "get": {
        "summary": "List the most recently detected security hotspots.",
        "operationId": "list_hotspots",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of hotspots to return (default 50, capped at 500).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Recent hotspots",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HotspotDto"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Storage backend unavailable"
          }
        }
      }
    },
    "/hotspots/{id}/status": {
      "put": {
        "summary": "Record a reviewer's verdict on a hotspot.",
        "operationId": "review_hotspot",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Hotspot id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HotspotReviewRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Hotspot after the review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HotspotDto"
                }
              }
            }
          },
          "400": {
            "description": "Unknown status"
          },
          "404": {
            "description": "Hotspot not found"
          },
          "502": {
            "description": "Storage backend unavailable"
          }
        }
      }
    },
    "/issues": {
      "get": {
        "summary": "Search issues with filters and pagination (newest first).",
        "operationId": "list_issues",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "1-based page number (default 1).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Page size (default 50, capped at 500).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "severity",
            "in": "query",
            "description": "Filter: info|minor|major|critical|blocker.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter: open|confirmed|resolved|closed.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rule",
            "in": "query",
            "description": "Filter: exact rule id, e.g. owasp:eval-usage.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "file",
            "in": "query",
            "description": "Filter: substring of the file path.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "assignee",
            "in": "query",
            "description": "Filter: exact assignee.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "facets",
            "in": "query",
            "description": "Comma-separated facets to compute alongside the page:\nseverity, status, rule (e.g. `facets=severity,rule`).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of matching issues",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuePageDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter value"
          },
          "502": {
            "description": "Storage backend unavailable"
          }
        }
      }
    },
    "/issues/bulk-transition": {
      "post": {
        "summary": "Apply the same transition to many issues at once. Each issue succeeds or\nfails independently — one illegal transition does not abort the batch.",
        "operationId": "bulk_transition_issues",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkTransitionRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Per-issue outcomes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BulkOutcomeDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unknown transition or resolution"
          },
          "502": {
            "description": "Storage backend unavailable"
          }
        }
      }
    },
    "/issues/{id}/assignee": {
      "put": {
        "summary": "Assign or unassign an issue.",
        "operationId": "assign_issue",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Issue id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssigneeRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Issue after the assignment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueDto"
                }
              }
            }
          },
          "404": {
            "description": "Issue not found"
          },
          "502": {
            "description": "Storage backend unavailable"
          }
        }
      }
    },
    "/issues/{id}/changelog": {
      "get": {
        "summary": "The recorded workflow history of an issue (audit trail).",
        "operationId": "issue_changelog",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Issue id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Changelog entries, oldest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChangelogEntryDto"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Storage backend unavailable"
          }
        }
      }
    },
    "/issues/{id}/transitions": {
      "post": {
        "summary": "Apply a workflow transition to an issue.",
        "operationId": "transition_issue",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Issue id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransitionRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Issue after the transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssueDto"
                }
              }
            }
          },
          "400": {
            "description": "Unknown transition or resolution"
          },
          "404": {
            "description": "Issue not found"
          },
          "409": {
            "description": "Transition not allowed from the current status"
          },
          "502": {
            "description": "Storage backend unavailable"
          }
        }
      }
    },
    "/rules": {
      "get": {
        "summary": "The catalog of every rule this server's analyzers ship with.",
        "operationId": "list_rules",
        "responses": {
          "200": {
            "description": "Rule catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RuleDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/scans": {
      "post": {
        "summary": "Enqueue a scan job for asynchronous analysis.",
        "operationId": "enqueue_scan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Scan job queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanQueuedDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid scan request"
          },
          "502": {
            "description": "Queue backend unavailable"
          }
        }
      }
    },
    "/scim/v2/Users": {
      "get": {
        "summary": "SCIM 2.0 User Provisioning Endpoint.",
        "operationId": "scim_users",
        "responses": {
          "200": {
            "description": "SCIM 2.0 user list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScimUserListDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentFixProposalDto": {
        "type": "object",
        "required": [
          "issue_id",
          "modified_code",
          "explanation"
        ],
        "properties": {
          "explanation": {
            "type": "string"
          },
          "issue_id": {
            "type": "integer",
            "format": "int64"
          },
          "modified_code": {
            "type": "string"
          }
        }
      },
      "AssigneeRequestDto": {
        "type": "object",
        "properties": {
          "assignee": {
            "type": [
              "string",
              "null"
            ],
            "description": "User to assign; null/omitted to unassign."
          }
        }
      },
      "AuthErrorDto": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "BulkOutcomeDto": {
        "type": "object",
        "required": [
          "issue_id",
          "status"
        ],
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "issue": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/IssueDto"
              }
            ]
          },
          "issue_id": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "BulkTransitionRequestDto": {
        "type": "object",
        "required": [
          "issue_ids",
          "transition"
        ],
        "properties": {
          "issue_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required when transition is `resolve`: fixed, wont-fix, false-positive."
          },
          "transition": {
            "type": "string",
            "description": "One of: confirm, resolve, reopen, close."
          }
        }
      },
      "ChangelogEntryDto": {
        "type": "object",
        "required": [
          "action",
          "at"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "assignee": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string"
          },
          "from_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          },
          "transition": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CreateWebhookDto": {
        "type": "object",
        "required": [
          "url",
          "secret",
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Event names such as `analysis.finished` or `gate.changed`."
          },
          "secret": {
            "type": "string",
            "description": "Shared signing secret. It is never returned by the API."
          },
          "url": {
            "type": "string",
            "description": "Absolute HTTP(S) endpoint that will receive JSON POST requests."
          }
        }
      },
      "CurrentUserDto": {
        "type": "object",
        "required": [
          "user",
          "session_expires_at"
        ],
        "properties": {
          "session_expires_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "user": {
            "$ref": "#/components/schemas/OAuthUserDto"
          }
        }
      },
      "DispatchWebhookDto": {
        "type": "object",
        "required": [
          "event",
          "payload"
        ],
        "properties": {
          "event": {
            "type": "string",
            "description": "Event name delivered in the `X-Yunq-Event` header and JSON envelope."
          },
          "payload": {
            "description": "Arbitrary event-specific JSON payload."
          },
          "webhook_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional registration id. When omitted, all subscribers receive it."
          }
        }
      },
      "FacetCountDto": {
        "type": "object",
        "required": [
          "value",
          "count"
        ],
        "properties": {
