{
  "version": 2,
  "builds": [
    {
      "src": "bin/server/src/main.rs",
      "use": "@vercel/rust"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "bin/server/src/main.rs"
    },
    {
      "src": "/scim/(.*)",
      "dest": "bin/server/src/main.rs"
    },
    {
      "src": "/health",
      "dest": "bin/server/src/main.rs"
    },
    {
      "src": "/api-docs/(.*)",
      "dest": "bin/server/src/main.rs"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
