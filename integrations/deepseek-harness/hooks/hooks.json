{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|edit|write",
        "hooks": [
          {
            "type": "command",
            "command": "vord",
            "args": ["hook", "claude-code"],
            "timeout": 30,
            "statusMessage": "vord guardrail"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|edit|write",
        "hooks": [
          {
            "type": "command",
            "command": "vord",
            "args": ["hook", "claude-code"],
            "timeout": 30,
            "statusMessage": "vord guardrail"
          }
        ]
      }
    ]
  }
}
