{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "title": "yunq Enterprise Platform Observability",
  "tags": ["yunq", "sast", "code-quality"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Total Scans Executed",
      "type": "stat",
      "targets": [
        { "expr": "yunq_scans_total", "legendFormat": "Scans Total" }
      ]
    },
    {
      "title": "Scan Throughput (LOC/sec)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(yunq_lines_of_code_total[5m])", "legendFormat": "LOC/sec" }
      ]
    },
    {
      "title": "Scan Duration p99 (seconds)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(yunq_scan_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99 duration" }
      ]
    },
    {
      "title": "Quality Gate Pass Rate",
      "type": "stat",
      "targets": [
        { "expr": "sum(yunq_gate_evaluations_total{status='passed'}) / sum(yunq_gate_evaluations_total) * 100", "legendFormat": "Pass Rate %" }
      ]
    }
  ],
  "schemaVersion": 36,
  "version": 1
}
